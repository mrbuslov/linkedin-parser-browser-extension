{
  "manifest_version": 3,
  "name": "LinkedIn Connection Tracker",
  "version": "0.1.0",
  "description": "Read-only tracker of sent LinkedIn invitations. Detects accepted connects by diffing the /sent/ page.",
  "permissions": ["notifications"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Connection Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/mynetwork/invitation-manager/sent/*"],
      "js": ["db-client.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["db-client.js", "profile.js"],
      "run_at": "document_idle"
    }
  ]
}
