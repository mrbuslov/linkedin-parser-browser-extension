{
  "manifest_version": 3,
  "name": "LinkedIn Connection Tracker",
  "version": "0.1.0",
  "description": "Read-only tracker of sent LinkedIn invitations. Detects accepted connects by diffing the /sent/ page.",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Connection Tracker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/mynetwork/invitation-manager/sent/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
