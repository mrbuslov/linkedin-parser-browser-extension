{
  "manifest_version": 3,
  "name": "LinkedIn Parser: Invites & Contacts",
  "version": "1.2.3",
  "description": "LinkedIn parser & tracker. Sent invitations, accepted/declined connections, contacts auto-saved. 100% local.",
  "permissions": ["notifications"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Connection Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/mynetwork/invitation-manager/sent/*"],
      "js": [
        "db-client.js",
        "core/url.js",
        "core/diff-sent.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": [
        "db-client.js",
        "core/url.js",
        "core/rsc-parser.js",
        "core/detect.js",
        "core/contacts-modal.js",
        "core/profile-state.js",
        "profile.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/mynetwork/invite-connect/connections/*"],
      "js": [
        "db-client.js",
        "core/url.js",
        "core/parseDate.js",
        "core/merge-connections.js",
        "connections.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
